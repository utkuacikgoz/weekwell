# Copy to .env (never commit .env). All secrets come from a secret manager in production.
PORT=8787
DATABASE_PATH=./weekwell.db
# 32+ random bytes, base64. Used to hash emails and session tokens.
SESSION_SECRET=
# Shared secret for store webhooks (from the subscription provider, D-014).
WEBHOOK_SECRET=
# Comma-separated allowed browser origins. Native apps send no Origin header.
CORS_ORIGINS=http://localhost:8081
# Development only: return login codes in the API response instead of emailing them.
ALLOW_DEV_CODES=0
# sample | fresh | stale | expired | verified | partial | unavailable (fixture provider until D-011)
PRICE_SOURCE=sample
# mock (trial started by the app) | store (trials only via verified store webhooks, D-014)
STORE_MODE=mock
