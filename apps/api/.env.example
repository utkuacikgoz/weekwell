# Copy to .env (never commit .env). All secrets come from a secret manager in production.
PORT=8787
DATABASE_PATH=./weekwell.db
# 32+ random bytes, base64. Used to hash emails and session tokens.
SESSION_SECRET=
# Shared secret for store webhooks (from the subscription provider, D-014).
WEBHOOK_SECRET=
# Comma-separated allowed browser origins. Native apps send no Origin header.
CORS_ORIGINS=http://localhost:8081
# Development only: return login codes in the API response instead of emailing them.
ALLOW_DEV_CODES=0
# auto (store check when present and under 45 days old, else sample) | sample | checked | fresh | stale | expired | verified | partial | unavailable
PRICE_SOURCE=auto
# mock (the app starts trials itself; development only) | store (signed generic webhooks)
# | revenuecat (D-014: RevenueCat webhooks, re-read from RevenueCat's REST API)
STORE_MODE=mock
# RevenueCat secret API key (Project settings > API keys > secret key, starts with sk_). Server only.
REVENUECAT_SECRET_KEY=
# The exact Authorization header value set on the RevenueCat webhook (24+ random chars).
REVENUECAT_WEBHOOK_AUTH=
# Resend (D-013): API key and a sender on a verified domain, e.g. "Weekwell <signin@mail.example.com>".
RESEND_API_KEY=
EMAIL_FROM=
