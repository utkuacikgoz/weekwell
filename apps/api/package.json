{
  "name": "@weekwell/api",
  "version": "0.1.0",
  "private": true,
  "description": "Weekwell pilot API: auth, plans, generation jobs, prices, entitlements, deletion (mobile workstream A4-A6).",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
