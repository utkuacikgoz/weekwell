    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@weekwell/domain": "*",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
