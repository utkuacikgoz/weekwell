{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["test/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "src/theme/palette.ts", "src/forbidden.ts"]
}
